@startuml Class Diagram
    class main{
        }
    class SystemMonitor{
        - _check_consistency : bool
        - _sources : std::vector<std::string>
        - _map_nodes : std::unordered_map<std::string, sonia_common_ros2::msg::NodeStatus>
    
        + SystemMonitor()
        + ~SystemMonitor()
        - proccessNodeStatusCallback(msg : sonia_common_ros2::msg::NodeStatus) : void
