        - checkConsistency(node_name : std::string) : void       

    }
    struct MonitoredNode{
        rclcpp::Time recieved_stamp;
        rclcpp::Time last_published_stamp;
        sonia_common_ros2::msg::NodeStatus node_status;
    }
@enduml